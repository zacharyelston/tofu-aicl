# Create RAG Index for Self-Building Experiments
# This indexes the entire codebase into Pinecone for pattern retrieval

terraform {
  required_providers {
    loader = {
      source  = "aicl/file_loader"
      version = "~> 1.0"
    }
    splitter = {
      source  = "aicl/text_splitter"
      version = "~> 1.0"
    }
    openai = {
      source  = "aicl/openai"
      version = "~> 1.0"
    }
    pinecone = {
      source  = "aicl/pinecone"
      version = "~> 1.0"
    }
  }
}

# Load all Python source code
resource "loader_files" "codebase" {
  path = "./src"
  glob = "**/*.py"
}

# Load provider implementations
resource "loader_files" "providers" {
  path = "./providers"
  glob = "**/*.py"
}

# Load v2 architecture code
resource "loader_files" "v2_code" {
  path = "./v2"
  glob = "**/*.py"
}

# Load provider configs
resource "loader_files" "configs" {
  path = "./providers"
  glob = "**/config.yaml"
}

# Load outline specs
resource "loader_files" "specs" {
  path = "./outline"
  glob = "*.md"
}

# Combine all documents
data "local_file" "all_docs" {
  content = jsonencode({
    documents = concat(
      jsondecode(resource.loader_files.codebase.attributes.documents),
      jsondecode(resource.loader_files.providers.attributes.documents),
      jsondecode(resource.loader_files.v2_code.attributes.documents),
      jsondecode(resource.loader_files.configs.attributes.documents),
      jsondecode(resource.loader_files.specs.attributes.documents)
    )
  })
}

# Split into chunks
resource "splitter_text" "chunks" {
  documents     = data.local_file.all_docs.content.documents
  chunk_size    = 1000
  chunk_overlap = 200
}

# Generate embeddings
resource "openai_embedding" "vectors" {
  texts = resource.splitter_text.chunks.attributes.chunks
  model = "text-embedding-3-small"
}

# Upsert to Pinecone
resource "pinecone_upsert" "index" {
  vectors   = resource.openai_embedding.vectors.attributes.embeddings
  index     = "tofu-aicl-knowledge"
  namespace = "codebase"
}

output "stats" {
  value = {
    total_chunks  = length(resource.splitter_text.chunks.attributes.chunks)
    total_vectors = length(resource.openai_embedding.vectors.attributes.embeddings)
    index_name    = "tofu-aicl-knowledge"
    namespace     = "codebase"
  }
}
