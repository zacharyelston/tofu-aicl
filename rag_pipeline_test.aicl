terraform {
  required_providers {
    loader = {
      source  = "aicl/file_loader"
      version = "~> 1.0"
      container = {
        image = "aicl/file_loader:1.0.0"
      }
    }
    splitter = {
      source  = "aicl/text_splitter"
      version = "~> 1.0"
      container = {
        image = "aicl/text_splitter:1.0.0"
      }
    }
  }
}

resource "loader_files" "docs" {
  path = "./docs"
  glob = "**/*.md"
}

resource "splitter_text" "chunks" {
  documents     = resource.loader_files.docs.attributes.documents
  chunk_size    = 500
  chunk_overlap = 50
}
