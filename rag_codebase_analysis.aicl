terraform {
  required_providers {
    loader = {
      source  = "aicl/file_loader"
      version = "~> 1.0"
      container = {
        image = "aicl/file_loader:1.0.0"
      }
    }
    splitter = {
      source  = "aicl/text_splitter"
      version = "~> 1.0"
      container = {
        image = "aicl/text_splitter:1.0.0"
      }
    }
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
      container = {
        image = "aicl/openrouter:1.0.0"
      }
    }
    pinecone = {
      source  = "aicl/pinecone"
      version = "~> 1.0"
      container = {
        image = "aicl/pinecone:1.0.0"
      }
    }
  }
}

# Load the entire AICL codebase
resource "loader_files" "aicl_codebase" {
  path = "./src"
  glob = "**/*.py"
}

# Split code into chunks for better analysis
resource "splitter_text" "code_chunks" {
  documents     = resource.loader_files.aicl_codebase.attributes.documents
  chunk_size    = 2000
  chunk_overlap = 200
}

# Generate embeddings for the codebase
resource "openrouter_embeddings" "codebase_vectors" {
  texts = resource.splitter_text.code_chunks.attributes.chunks
  model = "openai/text-embedding-3-small"
}

# Store vectors in Pinecone for retrieval
resource "pinecone_upsert" "codebase_index" {
  vectors   = resource.openrouter_embeddings.codebase_vectors.attributes.embeddings
  namespace = "aicl-codebase"
}

# Query the codebase about RAG comparison framework
resource "pinecone_query" "rag_comparison_context" {
  vector            = resource.openrouter_embeddings.codebase_vectors.attributes.embeddings[0].values
  top_k             = 5
  namespace         = "aicl-codebase"
  include_metadata  = true
}

# Use OpenRouter to analyze the RAG comparison framework and suggest improvements
resource "openrouter_query" "code_analysis" {
  query   = "Based on the AICL codebase, analyze the RAG comparison framework we built. What are the key architectural patterns? How can we improve the real API integration for provider comparisons? What's the best way to replace simulation code with actual AICL pipeline orchestration?"
  context = resource.pinecone_query.rag_comparison_context.attributes.matches
  model   = "anthropic/claude-3.5-sonnet"
  max_tokens = 2000
}

# Ask OpenRouter to help optimize the experiment orchestration
resource "openrouter_query" "optimization_suggestions" {
  query   = "Looking at the AICL architecture, how should we structure the RAG comparison experiments to get the most accurate cost and performance comparisons across OpenAI, Azure, and OpenRouter providers? What are the key metrics we should track?"
  context = resource.pinecone_query.rag_comparison_context.attributes.matches
  model   = "anthropic/claude-3.5-sonnet"
  max_tokens = 1500
}

# Output the analysis results
output "codebase_files_analyzed" {
  value = length(resource.loader_files.aicl_codebase.attributes.documents)
}

output "code_chunks_created" {
  value = length(resource.splitter_text.code_chunks.attributes.chunks)
}

output "embeddings_generated" {
  value = length(resource.openrouter_embeddings.codebase_vectors.attributes.embeddings)
}

output "code_analysis_response" {
  value = resource.openrouter_query.code_analysis.attributes.response
}

output "optimization_suggestions_response" {
  value = resource.openrouter_query.optimization_suggestions.attributes.response
}

output "total_cost_estimate" {
  value = "Real cost from OpenRouter API calls"
}
