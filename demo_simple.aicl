terraform {
  required_providers {
    openrouter = {
      source = "aicl/openrouter"
    }
  }
}

resource "chat" "greeting" {
  model = "anthropic/claude-3.5-sonnet"
  messages = [
    {
      role = "user"
      content = "Explain what AICL (AI Configuration Language) is in 2-3 sentences."
    }
  ]
  max_tokens = 200
}
