terraform {
  required_providers {
    loader = {
      source  = "aicl/file_loader"
      version = "~> 1.0"
    }
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
    }
  }
}

resource "loader_files" "docs" {
  path = "./docs"
  glob = "**/*.md"
}

resource "chat" "summary" {
  model = "anthropic/claude-3.5-sonnet"
  messages = [
    {
      role = "user"
      content = "Summarize the following documentation:\n\n${resource.loader_files.docs.attributes.documents}"
    }
  ]
  max_tokens = 500
}