#!/usr/bin/env python3
"""
AICL CLI - Declarative AI Infrastructure Command Line Interface

Usage:
  aicl run <config.aicl> [options]
  aicl validate <config.aicl>
  aicl state list [--experiment=<id>]
  aicl state show <resource-id> [--experiment=<id>]
  aicl providers list
  aicl config show
  aicl docker run <config.aicl> [options]
  aicl docker shell
  aicl --version

Options:
  -e, --env-file=<path>     Path to .env file [default: .env]
  -c, --config=<path>       Path to config file [default: ~/.aicl/config.yaml]
  -w, --workdir=<path>      Working directory [default: .]
  -v, --verbose             Verbose output
  --experiment-id=<id>      Experiment ID [default: default-exp]
  --docker                  Run in Docker container
  --no-docker               Run locally (default)
  --mount=<paths>           Additional volumes to mount (Docker mode)
"""

import sys
import os
import subprocess
import argparse
import yaml
import json
from pathlib import Path
from typing import Dict, Any, Optional, List
from dotenv import load_dotenv

class AICLConfig:
    """Manage AICL configuration from multiple sources with precedence"""
    
    def __init__(self, config_file: Optional[str] = None, env_file: Optional[str] = None):
        self.config_file = config_file or os.path.expanduser("~/.aicl/config.yaml")
        self.env_file = env_file or ".env"
        self.config = {}
        self._load_config()
    
    def _load_config(self):
        """Load configuration with precedence: CLI args > env vars > config file > defaults"""
        
        # 1. Load defaults
        self.config = {
            'runtime': {
                'mode': 'local',  # local or docker
                'docker_image': 'tofu-aicl:latest',
                'provider_mode': 'subprocess'
            },
            'paths': {
                'state_dir': './terraform.tfstate.d',
                'experiments_dir': './experiments',
                'providers_dir': './providers'
            },
            'docker': {
                'auto_pull': False,
                'remove_after': True,
                'mounts': []
            },
            'observability': {
                'enabled': True,
                'export_format': 'json',
                'metrics_port': 8000
            }
        }
        
        # 2. Load from config file
        if Path(self.config_file).exists():
            with open(self.config_file, 'r') as f:
                file_config = yaml.safe_load(f) or {}
                self._deep_merge(self.config, file_config)
        
        # 3. Load environment variables
        if Path(self.env_file).exists():
            load_dotenv(self.env_file)
        
        # Override with env vars
        if os.getenv('AICL_RUNTIME_MODE'):
            self.config['runtime']['mode'] = os.getenv('AICL_RUNTIME_MODE')
        if os.getenv('AICL_DOCKER_IMAGE'):
            self.config['runtime']['docker_image'] = os.getenv('AICL_DOCKER_IMAGE')
    
    def _deep_merge(self, base: Dict, update: Dict):
        """Deep merge update dict into base dict"""
        for key, value in update.items():
            if key in base and isinstance(base[key], dict) and isinstance(value, dict):
                self._deep_merge(base[key], value)
            else:
                base[key] = value
    
    def get(self, key: str, default: Any = None) -> Any:
        """Get config value using dot notation (e.g., 'runtime.mode')"""
        keys = key.split('.')
        value = self.config
        for k in keys:
            if isinstance(value, dict):
                value = value.get(k)
            else:
                return default
        return value if value is not None else default


class AICLDockerRunner:
    """Run AICL configurations in Docker containers"""
    
    def __init__(self, config: AICLConfig):
        self.config = config
        self.image = config.get('runtime.docker_image')
    
    def run(self, aicl_file: str, workdir: str = '.', mounts: Optional[List[str]] = None, **kwargs):
        """Run AICL configuration in Docker container"""
        
        # Build docker run command
        cmd = ['docker', 'run', '--rm']
        
        # Add environment file
        env_file = self.config.env_file
        if Path(env_file).exists():
            cmd.extend(['--env-file', env_file])
        
        # Add volume mounts
        workdir_abs = os.path.abspath(workdir)
        
        # Mount working directory
        cmd.extend(['-v', f'{workdir_abs}:/app/work:ro'])
        
        # Mount state directory for persistence
        state_dir = self.config.get('paths.state_dir', './terraform.tfstate.d')
        state_dir_abs = os.path.abspath(state_dir)
        os.makedirs(state_dir_abs, exist_ok=True)
        cmd.extend(['-v', f'{state_dir_abs}:/app/terraform.tfstate.d'])
        
        # Mount experiments directory
        exp_dir = self.config.get('paths.experiments_dir', './experiments')
        exp_dir_abs = os.path.abspath(exp_dir)
        os.makedirs(exp_dir_abs, exist_ok=True)
        cmd.extend(['-v', f'{exp_dir_abs}:/app/experiments'])
        
        # Add custom mounts
        for mount in (mounts or []):
            cmd.extend(['-v', mount])
        
        # Add image and command
        cmd.append(self.image)
        cmd.extend(['python3', 'run.py', f'/app/work/{aicl_file}'])
        
        # Set experiment ID if provided
        if kwargs.get('experiment_id'):
            os.environ['AICL_EXPERIMENT_ID'] = kwargs['experiment_id']
        
        print(f"🐳 Running in Docker: {' '.join(cmd)}")
        
        # Execute
        try:
            result = subprocess.run(cmd, check=True)
            return result.returncode
        except subprocess.CalledProcessError as e:
            print(f"❌ Docker execution failed: {e}")
            return e.returncode
    
    def shell(self, workdir: str = '.'):
        """Start interactive shell in container"""
        cmd = [
            'docker', 'run', '--rm', '-it',
            '--env-file', self.config.env_file,
            '-v', f'{os.path.abspath(workdir)}:/app/work',
            '-w', '/app/work',
            '--entrypoint', '/bin/bash',
            self.image
        ]
        
        print(f"🐳 Starting interactive shell...")
        subprocess.run(cmd)


class AICLLocalRunner:
    """Run AICL configurations locally"""
    
    def __init__(self, config: AICLConfig):
        self.config = config
    
    def run(self, aicl_file: str, workdir: str = '.', **kwargs):
        """Run AICL configuration locally"""
        
        # Change to working directory
        original_dir = os.getcwd()
        os.chdir(workdir)
        
        try:
            # Import and run locally
            sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            from src.aicl.core.engine import AICLEngine
            
            print(f"🚀 Running locally: {aicl_file}")
            
            engine = AICLEngine(config_path=aicl_file)
            engine.run()
            
            return 0
        except Exception as e:
            print(f"❌ Execution failed: {e}")
            return 1
        finally:
            os.chdir(original_dir)


class AICLCLI:
    """Main CLI application"""
    
    def __init__(self):
        self.parser = self._build_parser()
    
    def _build_parser(self):
        parser = argparse.ArgumentParser(
            prog='aicl',
            description='AICL - Declarative AI Infrastructure CLI',
            formatter_class=argparse.RawDescriptionHelpFormatter
        )
        
        # Global options
        parser.add_argument('-e', '--env-file', default='.env', help='Path to .env file')
        parser.add_argument('-c', '--config', default='~/.aicl/config.yaml', help='Path to config file')
        parser.add_argument('-v', '--verbose', action='store_true', help='Verbose output')
        parser.add_argument('--version', action='version', version='aicl 1.0.0')
        
        subparsers = parser.add_subparsers(dest='command', help='Commands')
        
        # run command
        run_parser = subparsers.add_parser('run', help='Run an AICL configuration')
        run_parser.add_argument('config_file', help='AICL configuration file')
        run_parser.add_argument('-w', '--workdir', default='.', help='Working directory')
        run_parser.add_argument('--experiment-id', default='default-exp', help='Experiment ID')
        run_parser.add_argument('--docker', action='store_true', help='Run in Docker')
        run_parser.add_argument('--no-docker', dest='docker', action='store_false', help='Run locally')
        run_parser.add_argument('--mount', action='append', help='Additional Docker mounts')
        
        # validate command
        val_parser = subparsers.add_parser('validate', help='Validate an AICL configuration')
        val_parser.add_argument('config_file', help='AICL configuration file')
        
        # state commands
        state_parser = subparsers.add_parser('state', help='Manage state')
        state_sub = state_parser.add_subparsers(dest='state_command')
        
        state_list = state_sub.add_parser('list', help='List resources')
        state_list.add_argument('--experiment-id', default='default-exp')
        
        state_show = state_sub.add_parser('show', help='Show resource details')
        state_show.add_argument('resource_id', help='Resource ID')
        state_show.add_argument('--experiment-id', default='default-exp')
        
        # providers command
        subparsers.add_parser('providers', help='List available providers')
        
        # config command
        subparsers.add_parser('config', help='Show current configuration')
        
        # docker commands
        docker_parser = subparsers.add_parser('docker', help='Docker utilities')
        docker_sub = docker_parser.add_subparsers(dest='docker_command')
        
        docker_run = docker_sub.add_parser('run', help='Run in Docker')
        docker_run.add_argument('config_file', help='AICL configuration file')
        docker_run.add_argument('-w', '--workdir', default='.', help='Working directory')
        docker_run.add_argument('--mount', action='append', help='Additional mounts')
        
        docker_sub.add_parser('shell', help='Interactive Docker shell')
        
        return parser
    
    def run(self, args=None):
        """Execute CLI command"""
        parsed_args = self.parser.parse_args(args)
        
        if not parsed_args.command:
            self.parser.print_help()
            return 1
        
        # Load configuration
        config = AICLConfig(
            config_file=parsed_args.config,
            env_file=parsed_args.env_file
        )
        
        # Execute command
        if parsed_args.command == 'run':
            return self._run_config(parsed_args, config)
        elif parsed_args.command == 'validate':
            return self._validate_config(parsed_args, config)
        elif parsed_args.command == 'state':
            return self._manage_state(parsed_args, config)
        elif parsed_args.command == 'providers':
            return self._list_providers(config)
        elif parsed_args.command == 'config':
            return self._show_config(config)
        elif parsed_args.command == 'docker':
            return self._docker_command(parsed_args, config)
        
        return 1
    
    def _run_config(self, args, config):
        """Run AICL configuration"""
        
        # Determine runtime mode
        use_docker = args.docker if hasattr(args, 'docker') else config.get('runtime.mode') == 'docker'
        
        if use_docker:
            runner = AICLDockerRunner(config)
            return runner.run(
                args.config_file,
                workdir=args.workdir,
                mounts=args.mount if hasattr(args, 'mount') else None,
                experiment_id=args.experiment_id if hasattr(args, 'experiment_id') else None
            )
        else:
            runner = AICLLocalRunner(config)
            return runner.run(
                args.config_file,
                workdir=args.workdir,
                experiment_id=args.experiment_id if hasattr(args, 'experiment_id') else None
            )
    
    def _validate_config(self, args, config):
        """Validate AICL configuration"""
        try:
            from src.aicl.parser import HCLParser
            parser = HCLParser(args.config_file)
            parsed = parser.parse()
            print(f"✅ Configuration is valid: {args.config_file}")
            print(json.dumps(parsed, indent=2))
            return 0
        except Exception as e:
            print(f"❌ Validation failed: {e}")
            return 1
    
    def _manage_state(self, args, config):
        """Manage state"""
        from src.aicl.state.manager import StateManager
        
        state_dir = config.get('paths.state_dir')
        manager = StateManager(state_dir=state_dir)
        
        if args.state_command == 'list':
            state = manager.load(args.experiment_id)
            print(f"📊 State for experiment: {args.experiment_id}")
            print(f"Resources: {len(state.resources)}")
            for res_id, resource in state.resources.items():
                print(f"  - {res_id} ({resource.type}) [{resource.status}]")
            return 0
        
        elif args.state_command == 'show':
            state = manager.load(args.experiment_id)
            resource = manager.get_resource(args.resource_id)
            if resource:
                print(json.dumps({
                    'id': resource.id,
                    'type': resource.type,
                    'provider': resource.provider,
                    'status': resource.status,
                    'attributes': resource.attributes,
                    'metadata': resource.metadata
                }, indent=2))
                return 0
            else:
                print(f"❌ Resource not found: {args.resource_id}")
                return 1
        
        return 1
    
    def _list_providers(self, config):
        """List available providers"""
        from v2.config import ProviderConfigLoader
        
        loader = ProviderConfigLoader()
        providers = loader.list_all()
        
        print(f"📦 Available providers: {len(providers)}")
        for provider in providers:
            print(f"\n  {provider.name} ({provider.source})")
            print(f"    Version: {provider.version}")
            print(f"    Mode: {provider.runtime.mode}")
            print(f"    Port: {provider.default_port}")
        
        return 0
    
    def _show_config(self, config):
        """Show current configuration"""
        print("⚙️  Current AICL Configuration:")
        print(yaml.dump(config.config, default_flow_style=False))
        return 0
    
    def _docker_command(self, args, config):
        """Handle docker subcommands"""
        runner = AICLDockerRunner(config)
        
        if args.docker_command == 'run':
            return runner.run(
                args.config_file,
                workdir=args.workdir,
                mounts=args.mount
            )
        elif args.docker_command == 'shell':
            runner.shell(workdir=args.workdir if hasattr(args, 'workdir') else '.')
            return 0
        
        return 1


def main():
    cli = AICLCLI()
    sys.exit(cli.run())


if __name__ == '__main__':
    main()
