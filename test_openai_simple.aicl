terraform {
  required_providers {
    openai = {
      source  = "aicl/openai"
      version = "~> 1.0"
      container = {
        image = "aicl/openai:1.0.0"
      }
    }
  }
}

# Simple embedding test
resource "embedding" "test" {
  text = "This is a test document for RAG comparison"
  model = "text-embedding-3-small"
}

output "embedding_length" {
  value = length(resource.embedding.test.attributes.embedding)
}

output "model_used" {
  value = resource.embedding.test.attributes.model
}
