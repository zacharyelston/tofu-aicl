terraform {
  required_providers {
    openrouter = {
      source = "aicl/openrouter"
    }
  }
}

resource "chat" "test_response" {
  model = "openai/gpt-4o-mini"
  messages = [
    {
      role = "user"
      content = "Write a haiku about: AI orchestration"
    }
  ]
  aiclResourceName = "test_response"
}
