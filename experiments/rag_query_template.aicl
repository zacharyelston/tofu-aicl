resource "embedding" "query_vector" {
  provider = "aicl/openai"
  config = {
    text = "{{QUESTION}}"
    model = "text-embedding-3-small"
  }
}

resource "search_results" "relevant_code" {
  provider = "aicl/pinecone"
  config = {
    operation = "query"
    vector = "${resource.embedding.query_vector.attributes.embedding}"
    top_k = 3
    namespace = "tofu-aicl-codebase"
  }
}

resource "answer" "rag_response" {
  provider = "aicl/openrouter"
  config = {
    resource_type = "chat"
    model = "{{MODEL}}"
    messages = [
      {
        role = "system"
        content = "You are a helpful assistant that answers questions about the tofu-aicl codebase based on the provided context."
      },
      {
        role = "user"
        content = "Context:\n${resource.search_results.relevant_code.attributes.matches}\n\nQuestion: {{QUESTION}}\n\nProvide a clear, concise answer based on the context above."
      }
    ]
    temperature = 0.3
    max_tokens = 500
  }
}
