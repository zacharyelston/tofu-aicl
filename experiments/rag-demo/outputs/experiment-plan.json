    },
    {
      "stage": 7,
      "name": "Retrieve Context",
      "description": "Get top 5 relevant chunks from Pinecone"
    },
    {
      "stage": 8,
      "name": "Answer (GPT-4o Mini)",
      "description": "Generate answer using RAG context"
    },
    {
      "stage": 9,
      "name": "Answer (Claude 3.5 Sonnet)",
      "description": "Generate answer using RAG context"
    },
    {
      "stage": 10,
      "name": "Answer (Gemini Pro 1.5)",
      "description": "Generate answer using RAG context"
    },
    {
      "stage": 11,
      "name": "Judge Evaluation",
      "description": "GPT-4o evaluates all 3 answers WITH RAG context"
    }
