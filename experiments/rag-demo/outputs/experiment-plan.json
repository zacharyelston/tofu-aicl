  "models": {
    "embedding": "text-embedding-3-small",
    "vector_db": "Pinecone",
    "answer_models": [
      "GPT-4o Mini",
      "Claude 3.5 Sonnet",
      "Gemini Pro 1.5"
    ],
    "judge_model": "GPT-4o"
  }
