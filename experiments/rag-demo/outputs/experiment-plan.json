    },
    {
      "stage": 4,
      "name": "Index Vectors",
      "description": "Store in Pinecone namespace: rag-demo-live"
    },
    {
      "stage": 5,
      "name": "Validate Retrieval",
      "description": "Test query to confirm RAG is working"
    },
    {
      "stage": 6,
