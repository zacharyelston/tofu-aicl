terraform {
  required_providers {
    file_loader = {
      source = "aicl/file_loader"
    }
    text_splitter = {
      source = "aicl/text_splitter"
    }
    openai = {
      source = "aicl/openai"
    }
    pinecone = {
      source = "aicl/pinecone"
    }
  }
}

resource "file_loader" "codebase_docs" {
  provider = "aicl/file_loader"
  config = {
    file_paths = [
      "src/aicl/parser.py",
      "src/aicl/evaluator.py", 
      "src/aicl/executor.py",
      "src/aicl/planner.py",
      "replit.md",
      "README.md"
    ]
  }
}

resource "text_splitter" "split_docs" {
  provider = "aicl/text_splitter"
  config = {
    text = "${resource.file_loader.codebase_docs.attributes.content}"
    chunk_size = 1000
    chunk_overlap = 200
  }
}

resource "embedding" "code_vectors" {
  provider = "aicl/openai"
  config = {
    texts = "${resource.text_splitter.split_docs.attributes.chunks}"
    model = "text-embedding-3-small"
  }
}

resource "upsert" "indexed_code" {
  provider = "aicl/pinecone"
  config = {
    vectors = "${resource.embedding.code_vectors.attributes.embeddings}"
    metadata = "${resource.text_splitter.split_docs.attributes.metadata}"
    namespace = "tofu-aicl-codebase"
  }
}
