# Self-Building Experiment: Add Echo Provider
# This experiment demonstrates AICL modifying its own source code

variable "quality_threshold" {
  type    = number
  default = 80
  description = "Minimum quality score to accept generated code"
}

variable "code_model" {
  type    = string
  default = "gpt-4o"
  description = "Model for code generation"
}

variable "judge_model" {
  type    = string
  default = "gpt-4o"
  description = "Model for code quality judging"
}

provider "openai" {
  api_key = env("OPENAI_API_KEY")
}

provider "pinecone" {
  api_key = env("PINECONE_API_KEY")
  host    = env("PINECONE_HOST_URL")
}

# Step 1: Query RAG for provider implementation patterns
data "vector_query" "provider_patterns" {
  provider  = provider.pinecone
  index     = "tofu-aicl-knowledge"
  namespace = "codebase"
  
  # Embed the query
  query_text = "How to implement a gRPC provider in AICL? Show provider implementation patterns and examples."
  top_k      = 5
}

# Step 2: Generate provider implementation
resource "llm_completion" "generate_provider" {
  provider    = provider.openai
  model       = var.code_model
  temperature = 0.3
  max_tokens  = 4000
  
  prompt = <<-EOT
    You are an expert Python developer. Generate a complete AICL provider implementation.
    
    SPECIFICATION:
    Create an Echo provider that implements the AICL provider gRPC interface:
    
    Resource Type: echo_text
    - Input attributes:
      - text (string): Text to echo back
      - prefix (string): Prefix to add (default: "Echo: ")
    - Output attributes:
      - echoed_text (string): The prefixed text
      - original_length (int): Length of original text
      - echoed_length (int): Length of echoed text
    
    REQUIREMENTS:
    1. Follow AICL provider patterns from the codebase
    2. Implement the ProviderServicer gRPC interface
    3. Use v2.runtime.create_provider_server for boilerplate
    4. Handle errors gracefully
    5. Include docstrings
    
    REFERENCE PATTERNS:
    ${data.vector_query.provider_patterns.results}
    
    Generate ONLY the Python code for providers/echo/server.py
    Include all necessary imports.
    
    CODE:
  EOT
}

# Step 3: Generate provider config
resource "llm_completion" "generate_config" {
  provider    = provider.openai
  model       = "gpt-4o-mini"
  temperature = 0.0
  max_tokens  = 1000
  
  prompt = <<-EOT
    Generate config.yaml for the echo provider following AICL conventions.
    
    REQUIREMENTS:
    - name: echo
    - display_name: Echo Provider
    - version: 1.0.0
    - default_port: 50060 (next available port)
    - mode: subprocess
    - resource_types: [echo_text]
    - operations: [create, read]
    
    Generate ONLY the YAML content for providers/echo/config.yaml
  EOT
}

# Step 4: Generate tests
resource "llm_completion" "generate_tests" {
  provider    = provider.openai
  model       = var.code_model
  temperature = 0.3
  max_tokens  = 3000
  
  prompt = <<-EOT
    Generate comprehensive pytest tests for the echo provider.
    
    TESTS TO INCLUDE:
    1. test_basic_echo - Basic functionality
    2. test_custom_prefix - Custom prefix parameter
    3. test_empty_input - Empty string handling
    4. test_special_characters - Unicode and special chars
    5. test_length_tracking - Verify length attributes
    
    Use pytest conventions and AICL testing patterns.
    
    Generate ONLY the Python code for providers/echo/test_echo.py
  EOT
}

# Step 5: Write generated files (simulated - would use file_writer provider)
output "generated_files" {
  value = {
    provider_code = resource.llm_completion.generate_provider.content
    provider_config = resource.llm_completion.generate_config.content
    test_code = resource.llm_completion.generate_tests.content
  }
}

# Step 6: Judge the quality of generated code
resource "llm_completion" "judge_quality" {
  provider    = provider.openai
  model       = var.judge_model
  temperature = 0.0
  max_tokens  = 2000
  
  prompt = <<-EOT
    You are an expert code reviewer. Evaluate the generated code quality.
    
    SPECIFICATION:
    Create an Echo provider with echo_text resource type.
    - Input: text, prefix (default "Echo: ")
    - Output: echoed_text, length metrics
    
    GENERATED PROVIDER CODE:
    ${resource.llm_completion.generate_provider.content}
    
    GENERATED CONFIG:
    ${resource.llm_completion.generate_config.content}
    
    GENERATED TESTS:
    ${resource.llm_completion.generate_tests.content}
    
    Evaluate on these criteria (100 points total):
    
    1. CORRECTNESS (40 points)
       - Implements specification fully
       - Follows gRPC provider interface
       - Resource attributes correct
       - Error handling present
    
    2. CODE QUALITY (30 points)
       - Follows AICL patterns
       - Clean and readable
       - Proper imports and structure
       - Uses v2.runtime helpers
    
    3. BEST PRACTICES (20 points)
       - Python idioms
       - gRPC best practices
       - Security (input validation)
       - Documentation
    
    4. MAINTAINABILITY (10 points)
       - Clear intent
       - Good variable names
       - Comments where needed
       - Easy to understand
    
    DECISION RULES:
    - Score >= 90: ACCEPT (Excellent)
    - Score 80-89: ACCEPT (Good)
    - Score 70-79: REVISE (Needs improvement)
    - Score < 70: REJECT (Inadequate)
    
    Respond ONLY with valid JSON:
    {
      "overall_score": <0-100>,
      "breakdown": {
        "correctness": <0-40>,
        "code_quality": <0-30>,
        "best_practices": <0-20>,
        "maintainability": <0-10>
      },
      "decision": "ACCEPT | REVISE | REJECT",
      "reasoning": "<detailed explanation>",
      "improvements": ["<suggestion 1>", "<suggestion 2>"]
    }
  EOT
}

# Parse judge response
output "quality_evaluation" {
  value = resource.llm_completion.judge_quality.content
}

# Final recommendation
output "recommendation" {
  value = <<-EOT
    === SELF-BUILD EXPERIMENT RESULTS ===
    
    Quality Score: [See quality_evaluation output]
    
    Generated Files:
    1. providers/echo/server.py (${length(resource.llm_completion.generate_provider.content)} chars)
    2. providers/echo/config.yaml (${length(resource.llm_completion.generate_config.content)} chars)
    3. providers/echo/test_echo.py (${length(resource.llm_completion.generate_tests.content)} chars)
    
    Next Steps:
    1. Review the generated code above
    2. Check the quality evaluation
    3. If score >= ${var.quality_threshold}, manually apply:
       - Copy provider_code to providers/echo/server.py
       - Copy provider_config to providers/echo/config.yaml
       - Copy test_code to providers/echo/test_echo.py
    4. Run: pytest providers/echo/test_echo.py
    5. Verify: The provider auto-discovers on next engine run
    
    === END RESULTS ===
  EOT
}

# Token usage tracking
output "cost_estimate" {
  value = {
    provider_generation_tokens = resource.llm_completion.generate_provider.usage.total_tokens
    config_generation_tokens = resource.llm_completion.generate_config.usage.total_tokens
    test_generation_tokens = resource.llm_completion.generate_tests.usage.total_tokens
    judging_tokens = resource.llm_completion.judge_quality.usage.total_tokens
    total_tokens = (
      resource.llm_completion.generate_provider.usage.total_tokens +
      resource.llm_completion.generate_config.usage.total_tokens +
      resource.llm_completion.generate_tests.usage.total_tokens +
      resource.llm_completion.judge_quality.usage.total_tokens
    )
  }
}
