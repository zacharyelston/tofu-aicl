terraform {
  required_providers {
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
      container = {
        image = "aicl/openrouter:1.0.0"
      }
    }
  }
}

# Define the prompts for short and long context tests
locals {
  base_prompt = "Summarize the key benefits of the AICL declarative framework for AI infrastructure."
  long_context = <<-EOC
    Summarize the key benefits of the AICL declarative framework for AI infrastructure. Focus on how it enables reproducible experiments, integrates with containerized providers, and tracks lineage using the built-in State as DNA manager. Provide a bullet list with at most five items and highlight any cost-saving advantages.
  EOC
}

# Define the models and contexts for the 2x2 matrix
variable "models" {
  type = map(string)
  default = {
    "claude_sonnet" = "anthropic/claude-3.5-sonnet"
    "gpt4o_mini"    = "openai/gpt-4o-mini"
  }
}

variable "contexts" {
  type = map(string)
  default = {
    "short" = local.base_prompt
    "long"  = local.long_context
  }
}

# Create a map of all model/context combinations for the test matrix
locals {
  combinations = {
    for combo in setproduct(keys(var.models), keys(var.contexts)) :
    "${combo[0]}_${combo[1]}" => {
      model   = var.models[combo[0]]
      context = var.contexts[combo[1]]
    }
  }
}

# Dynamically create an OpenRouter query for each combination
resource "openrouter_query" "matrix_test" {
  for_each = local.combinations

  query      = each.value.context
  model      = each.value.model
  max_tokens = 500
}

# Output the results in a structured format for easy comparison
output "matrix_results" {
  value = {
    for key, result in resource.openrouter_query.matrix_test :
    key => {
      response   = result.attributes.response
      cost       = result.attributes.usage.total_cost
      tokens     = result.attributes.usage.total_tokens
      model_used = result.attributes.model
    }
  }
  sensitive = true
}
