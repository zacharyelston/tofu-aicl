terraform {
  required_providers {
    openrouter = {
      source = "aicl/openrouter"
    }
  }
}

resource "chat" "test_response" {
  model = "openai/gpt-4"
  messages = [
    {
      role = "user"
      content = "List 3 benefits of: HCL configuration syntax"
    }
  ]
  aiclResourceName = "test_response"
}
