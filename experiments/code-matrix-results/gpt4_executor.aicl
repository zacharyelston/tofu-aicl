terraform {
  required_providers {
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
    }
  }
}

resource "chat" "analysis" {
  model = "openai/gpt-4"
  messages = [
    {
      role = "system"
      content = "You are a code review expert. Suggest specific, actionable improvements."
    },
    {
      role = "user"
      content = "Review this executor.py code and suggest 3 improvements:\n\nfrom google.protobuf.json_format import MessageToDict, ParseDict
from google.protobuf.struct_pb2 import Struct
import grpc
import proto.provider_pb2 as provider_pb2
from aicl.state.manager import ResourceState
from aicl.evaluator import HCLEvaluator

class Executor:
    def __init__(self, providers, state_manager):
        self.providers = providers
        self.state_manager = state_manager
        self.evaluator = HCLEvaluator(state_manager)

        # Map resource types to provider names
        self.resource_to_provider = {
            'file_loader': 'loader',
            'text_splitter': 'splitter',
            'embedding': 'openai',
            'azure_openai_embedding': 'azure_openai',
            'chat': 'openrouter',
            'upsert': 'pinecone',
            'query': 'pinecone',
        }

    def execute_node(self, node_id, resource_map):
        res_type, res_name, config_attrs = resource_map[node_id]

        # Map resource type to provider name
        provider_name = s"
    }
  ]
  max_tokens = 400
}
