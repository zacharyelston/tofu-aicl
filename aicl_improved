@docker_app.command("shell")
def docker_shell(
    workdir: Annotated[Path, typer.Option("--workdir", "-w", help="Working directory")] = Path("."),
):
    """
    🐚 Start interactive Docker shell
    
    Example:
        aicl docker shell
    """
    import subprocess
    
    logger.info("Starting Docker shell")
    
    console.print("[bold blue]🐳 Starting interactive Docker shell...[/bold blue]")
    
    cmd = [
        "docker", "run", "--rm", "-it",
        "--env-file", ".env",
        "-v", f"{workdir.absolute()}:/app/work",
        "-w", "/app/work",
        "--entrypoint", "/bin/bash",
        settings.runtime.docker_image,
    ]
    
    subprocess.run(cmd)


