#!/usr/bin/env python3
"""
AICL CLI - Improved Version with Best-in-Class Tooling

Dependencies (add to pyproject.toml):
    typer[all]>=0.9.0      # CLI framework (better than Cobra)
    dynaconf>=3.2.0        # Config management (Python's Viper)
    rich>=13.0.0           # Beautiful terminal output
    loguru>=0.7.0          # Amazing logging (simpler than structlog)
    pydantic>=2.0.0        # Config validation
"""

import sys
import os
from pathlib import Path
from typing import Optional, List, Annotated
from enum import Enum

import typer
from rich.console import Console
from rich.table import Table
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.panel import Panel
from rich.syntax import Syntax
from rich import print as rprint
from loguru import logger
from dynaconf import Dynaconf, Validator
from pydantic import BaseModel, Field, field_validator

# Initialize Rich console for beautiful output
console = Console()

# Initialize Typer app (like Cobra in Go)
app = typer.Typer(
    name="aicl",
    help="🚀 AICL - Declarative AI Infrastructure CLI",
    add_completion=True,
    rich_markup_mode="rich",
)

# Initialize Dynaconf (like Viper in Go)
settings = Dynaconf(
    envvar_prefix="AICL",  # All env vars start with AICL_
    settings_files=['~/.aicl/config.yaml', '.aicl.yaml', 'aicl.yaml'],
    environments=True,  # Support dev/staging/prod
    load_dotenv=True,   # Auto-load .env
    merge_enabled=True,  # Deep merge configs
    validators=[
        Validator('runtime.mode', is_in=['local', 'docker'], default='local'),
        Validator('runtime.docker_image', default='tofu-aicl:latest'),
        Validator('paths.state_dir', default='./terraform.tfstate.d'),
    ]
)


# Pydantic models for type-safe config
class RuntimeMode(str, Enum):
    """Runtime execution modes"""
    LOCAL = "local"
    DOCKER = "docker"


class RuntimeConfig(BaseModel):
    """Runtime configuration"""
    mode: RuntimeMode = RuntimeMode.LOCAL
    docker_image: str = "tofu-aicl:latest"
    provider_mode: str = "subprocess"


class PathsConfig(BaseModel):
    """Path configuration"""
    state_dir: Path = Field(default=Path("./terraform.tfstate.d"))
    experiments_dir: Path = Field(default=Path("./experiments"))
    providers_dir: Path = Field(default=Path("./providers"))

    @field_validator('*')
    def ensure_path(cls, v):
        """Ensure all paths are Path objects"""
        return Path(v) if not isinstance(v, Path) else v


class DockerConfig(BaseModel):
    """Docker-specific configuration"""
    auto_pull: bool = False
    remove_after: bool = True
    mounts: List[str] = Field(default_factory=list)
    network: str = "bridge"


class AICLConfig(BaseModel):
    """Complete AICL configuration"""
    runtime: RuntimeConfig = Field(default_factory=RuntimeConfig)
    paths: PathsConfig = Field(default_factory=PathsConfig)
    docker: DockerConfig = Field(default_factory=DockerConfig)


# Configure loguru (much simpler than Python's logging module)
def setup_logging(verbose: bool = False):
    """Setup beautiful structured logging"""
    logger.remove()  # Remove default handler
    
    log_format = (
        "<green>{time:YYYY-MM-DD HH:mm:ss}</green> | "
        "<level>{level: <8}</level> | "
        "<cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> | "
        "<level>{message}</level>"
    )
    
    level = "DEBUG" if verbose else "INFO"
    
    # Console handler with colors
    logger.add(
        sys.stderr,
        format=log_format,
        level=level,
        colorize=True,
        backtrace=True,
        diagnose=True,
    )
    
    # File handler for debugging
    logger.add(
        "logs/aicl_{time}.log",
        rotation="10 MB",
        retention="1 week",
        level="DEBUG",
        format=log_format,
    )
    
    return logger


# State callback for global options
@app.callback()
def main(
    ctx: typer.Context,
    verbose: Annotated[bool, typer.Option("--verbose", "-v", help="Enable verbose logging")] = False,
    config_file: Annotated[Optional[Path], typer.Option("--config", "-c", help="Config file path")] = None,
    env_file: Annotated[Optional[Path], typer.Option("--env-file", "-e", help="Environment file")] = None,
):
    """
    🚀 AICL - Declarative AI Infrastructure CLI
    
    Global options apply to all commands.
    """
    # Setup logging first
    ctx.obj = {"logger": setup_logging(verbose)}
    
    logger.info("AICL CLI starting", version="2.0.0")
    
    # Load config with Dynaconf
    if config_file:
        settings.configure(SETTINGS_FILE_FOR_DYNACONF=str(config_file))
    
    if env_file:
        settings.configure(DOTENV_PATH_FOR_DYNACONF=str(env_file))
    
    # Validate config
    settings.validators.validate()
    
    logger.debug("Configuration loaded", settings=settings.as_dict())


# Run command
@app.command()
def run(
    config_file: Annotated[Path, typer.Argument(help="AICL configuration file")],
    workdir: Annotated[Path, typer.Option("--workdir", "-w", help="Working directory")] = Path("."),
    experiment_id: Annotated[str, typer.Option("--experiment-id", help="Experiment ID")] = "default-exp",
    docker: Annotated[bool, typer.Option("--docker/--no-docker", help="Run in Docker")] = None,
    mount: Annotated[Optional[List[str]], typer.Option("--mount", help="Docker volume mounts")] = None,
):
    """
    🚀 Run an AICL configuration
    
    Examples:
        aicl run experiment.aicl
        aicl run experiment.aicl --docker
        aicl run experiment.aicl --mount ./data:/app/data:ro
    """
    logger.info("Starting AICL run", config=str(config_file), experiment_id=experiment_id)
    
    # Determine execution mode
    use_docker = docker if docker is not None else settings.runtime.mode == "docker"
    
    with Progress(
        SpinnerColumn(),
        TextColumn("[progress.description]{task.description}"),
        console=console,
    ) as progress:
        
        if use_docker:
            task = progress.add_task("🐳 Running in Docker...", total=None)
            _run_docker(config_file, workdir, experiment_id, mount)
        else:
            task = progress.add_task("🚀 Running locally...", total=None)
            _run_local(config_file, workdir, experiment_id)
        
        progress.update(task, completed=True)
    
    console.print(f"✅ [green]Execution complete![/green]")
    logger.success("Run completed", experiment_id=experiment_id)


def _run_docker(config_file: Path, workdir: Path, experiment_id: str, mounts: Optional[List[str]]):
    """Execute in Docker with rich output"""
    import subprocess
    
    cmd = ["docker", "run", "--rm"]
    
    # Environment
    if Path(".env").exists():
        cmd.extend(["--env-file", ".env"])
    
    # Mounts
    state_dir = Path(settings.paths.state_dir)
    state_dir.mkdir(parents=True, exist_ok=True)
    cmd.extend(["-v", f"{state_dir.absolute()}:/app/terraform.tfstate.d"])
    
    for mount in (mounts or settings.docker.mounts or []):
        cmd.extend(["-v", mount])
    
    # Image and command
    cmd.extend([settings.runtime.docker_image, "python3", "run.py", str(config_file)])
    
    logger.debug("Docker command", cmd=" ".join(cmd))
    
    # Execute with live output
    with console.status("[bold blue]Running Docker container..."):
        result = subprocess.run(cmd, capture_output=False, text=True)
    
    if result.returncode != 0:
        logger.error("Docker execution failed", return_code=result.returncode)
        raise typer.Exit(code=result.returncode)


def _run_local(config_file: Path, workdir: Path, experiment_id: str):
    """Execute locally with rich output"""
    import sys
    
    original_dir = Path.cwd()
    os.chdir(workdir)
    
    try:
        sys.path.insert(0, str(Path(__file__).parent))
        from src.aicl.core.engine import AICLEngine
        
        logger.info("Initializing AICL engine", config=str(config_file))
        
        with console.status("[bold green]Running AICL engine..."):
            engine = AICLEngine(config_path=str(config_file))
            engine.run()
        
    except Exception as e:
        logger.exception("Execution failed", error=str(e))
        console.print(f"[red]❌ Error:[/red] {e}")
        raise typer.Exit(code=1)
    finally:
        os.chdir(original_dir)


# Validate command
@app.command()
def validate(
    config_file: Annotated[Path, typer.Argument(help="AICL configuration file")],
):
    """
    ✅ Validate an AICL configuration
    
    Example:
        aicl validate experiment.aicl
    """
    logger.info("Validating configuration", config=str(config_file))
    
    try:
        from src.aicl.parser import HCLParser
        
        with console.status("[bold yellow]Parsing configuration..."):
            parser = HCLParser(str(config_file))
            parsed = parser.parse()
        
        # Display parsed config with syntax highlighting
        import json
        syntax = Syntax(
            json.dumps(parsed, indent=2),
            "json",
            theme="monokai",
            line_numbers=True,
        )
        
        console.print(Panel(
            syntax,
            title=f"✅ [green]Valid Configuration[/green]: {config_file}",
            border_style="green",
        ))
        
        logger.success("Configuration is valid", config=str(config_file))
        
    except Exception as e:
        logger.error("Validation failed", error=str(e))
        console.print(f"[red]❌ Validation failed:[/red] {e}")
        raise typer.Exit(code=1)


# State management commands
state_app = typer.Typer(help="📊 Manage experiment state")
app.add_typer(state_app, name="state")


@state_app.command("list")
def state_list(
    experiment_id: Annotated[str, typer.Option("--experiment-id", help="Experiment ID")] = "default-exp",
):
    """
    📋 List all resources in state
    
    Example:
        aicl state list
        aicl state list --experiment-id exp-001
    """
    logger.info("Listing state", experiment_id=experiment_id)
    
    try:
        from src.aicl.state.manager import StateManager
        
        manager = StateManager(state_dir=str(settings.paths.state_dir))
        state = manager.load(experiment_id)
        
        # Create rich table
        table = Table(
            title=f"📊 State: {experiment_id}",
            show_header=True,
            header_style="bold magenta",
        )
        table.add_column("Resource ID", style="cyan")
        table.add_column("Type", style="green")
        table.add_column("Provider", style="yellow")
        table.add_column("Status", style="blue")
        
        for res_id, resource in state.resources.items():
            status_icon = "✅" if resource.status == "ready" else "⏳"
            table.add_row(
                res_id,
                resource.type,
                resource.provider,
                f"{status_icon} {resource.status}",
            )
        
        console.print(table)
        
        logger.info("State listed", resource_count=len(state.resources))
        
    except Exception as e:
        logger.error("Failed to list state", error=str(e))
        console.print(f"[red]❌ Error:[/red] {e}")
        raise typer.Exit(code=1)


@state_app.command("show")
def state_show(
    resource_id: Annotated[str, typer.Argument(help="Resource ID")],
    experiment_id: Annotated[str, typer.Option("--experiment-id", help="Experiment ID")] = "default-exp",
):
    """
    🔍 Show detailed resource information
    
    Example:
        aicl state show loader_files-docs
    """
    logger.info("Showing resource", resource_id=resource_id, experiment_id=experiment_id)
    
    try:
        from src.aicl.state.manager import StateManager
        import json
        
        manager = StateManager(state_dir=str(settings.paths.state_dir))
        manager.load(experiment_id)
        resource = manager.get_resource(resource_id)
        
        if not resource:
            console.print(f"[red]❌ Resource not found:[/red] {resource_id}")
            raise typer.Exit(code=1)
        
        # Display as JSON with syntax highlighting
        resource_dict = {
            "id": resource.id,
            "type": resource.type,
            "provider": resource.provider,
            "status": resource.status,
            "attributes": resource.attributes,
            "metadata": resource.metadata,
        }
        
        syntax = Syntax(
            json.dumps(resource_dict, indent=2),
            "json",
            theme="monokai",
            line_numbers=True,
        )
        
        console.print(Panel(
            syntax,
            title=f"🔍 Resource: {resource_id}",
            border_style="cyan",
        ))
        
    except Exception as e:
        logger.error("Failed to show resource", error=str(e))
        console.print(f"[red]❌ Error:[/red] {e}")
        raise typer.Exit(code=1)


