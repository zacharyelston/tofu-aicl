terraform {
  required_providers {
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
    }
    evaluator = {
      source  = "aicl/evaluator"
      version = "~> 1.0"
    }
  }
}

# Test Question: Explain REST API authentication
variable "test_question" {
  default = "Explain authentication tokens in REST APIs. Include what they are, how they're generated, and security best practices."
}

# Experiment 1: Claude 3.5 Sonnet
resource "chat" "claude_response" {
  model = "anthropic/claude-3.5-sonnet"
  messages = [
    {
      role = "user"
      content = "Explain authentication tokens in REST APIs. Include what they are, how they're generated, and security best practices."
    }
  ]
  max_tokens = 300
}

resource "grade" "claude_grade" {
  response = "${resource.chat.claude_response.attributes.response}"
  context = ""
  criteria = [
    {
      name = "defines_tokens"
      type = "contains"
      value = "token"
      weight = 2
    },
    {
      name = "explains_generation"
      type = "contains"
      value = "generate"
      weight = 2
    },
    {
      name = "mentions_security"
      type = "contains"
      value = "security"
      weight = 2
    }
  ]
}

# Experiment 2: GPT-4
resource "chat" "gpt4_response" {
  model = "openai/gpt-4"
  messages = [
    {
      role = "user"
      content = "Explain authentication tokens in REST APIs. Include what they are, how they're generated, and security best practices."
    }
  ]
  max_tokens = 300
}

resource "grade" "gpt4_grade" {
  response = "${resource.chat.gpt4_response.attributes.response}"
  context = ""
  criteria = [
    {
      name = "defines_tokens"
      type = "contains"
      value = "token"
      weight = 2
    },
    {
      name = "explains_generation"
      type = "contains"
      value = "generate"
      weight = 2
    },
    {
      name = "mentions_security"
      type = "contains"
      value = "security"
      weight = 2
    }
  ]
}

# Compare results
resource "compare" "model_comparison" {
  results = [
    {
      model = "claude-3.5-sonnet"
      percentage = "${resource.grade.claude_grade.attributes.percentage}"
      total_score = "${resource.grade.claude_grade.attributes.total_score}"
      max_score = "${resource.grade.claude_grade.attributes.max_score}"
      passed = "${resource.grade.claude_grade.attributes.passed}"
    },
    {
      model = "gpt-4"
      percentage = "${resource.grade.gpt4_grade.attributes.percentage}"
      total_score = "${resource.grade.gpt4_grade.attributes.total_score}"
      max_score = "${resource.grade.gpt4_grade.attributes.max_score}"
      passed = "${resource.grade.gpt4_grade.attributes.passed}"
    }
  ]
}
