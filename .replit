modules = ["python-3.11"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["c-ares", "grpc", "openssl", "pkg-config", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AICL Engine"

[[workflows.workflow]]
name = "AICL Engine"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run.py experiments/rag-demo/rag-demo-live.aicl"

[[ports]]
localPort = 50051
externalPort = 3001

[[ports]]
localPort = 50054
externalPort = 3002

[[ports]]
localPort = 50055
externalPort = 3003

[[ports]]
localPort = 50056
externalPort = 80

[[ports]]
localPort = 50057
externalPort = 3000
