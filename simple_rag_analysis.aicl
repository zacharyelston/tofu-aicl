terraform {
  required_providers {
    loader = {
      source  = "aicl/file_loader"
      version = "~> 1.0"
      container = {
        image = "aicl/file_loader:1.0.0"
      }
    }
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
      container = {
        image = "aicl/openrouter:1.0.0"
      }
    }
  }
}

# Load key files from the RAG comparison framework
resource "loader_files" "rag_framework" {
  path = "./experiments/rag-comparison/scripts"
  glob = "*.py"
}

# Use OpenRouter to analyze the framework and provide recommendations
resource "openrouter_query" "framework_analysis" {
  query = "Analyze this RAG comparison framework code. I want to replace simulation code with real AICL pipeline orchestration. What are the key architectural improvements needed? How should I structure real API comparisons across OpenAI, Azure, and OpenRouter providers?"
  context = resource.loader_files.rag_framework.attributes.documents
  model = "anthropic/claude-3.5-sonnet"
  max_tokens = 2000
  temperature = 0.3
}

# Ask for specific implementation guidance
resource "openrouter_query" "implementation_guide" {
  query = "Based on the AICL architecture, provide specific code recommendations for creating a real RAG comparison system. How should I structure the experiment orchestration? What metrics should I track for cost and performance comparisons?"
  context = resource.loader_files.rag_framework.attributes.documents
  model = "anthropic/claude-3.5-sonnet"
  max_tokens = 1500
  temperature = 0.2
}

# Output the analysis
output "files_analyzed" {
  value = length(resource.loader_files.rag_framework.attributes.documents)
}

output "framework_analysis" {
  value = resource.openrouter_query.framework_analysis.attributes.response
}

output "implementation_recommendations" {
  value = resource.openrouter_query.implementation_guide.attributes.response
}

output "analysis_cost" {
  value = resource.openrouter_query.framework_analysis.attributes.usage.total_cost
}
