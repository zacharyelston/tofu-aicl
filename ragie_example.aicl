terraform {
  required_providers {
    ragie = { source = "aicl/ragie" }
    naga = { source = "aicl/naga" }
  }
}

# Upload a document to Ragie for indexing
resource "ragie_upload" "codebase_docs" {
  file_path = "replit.md"
  name = "AICL Framework Documentation"
  partition = "aicl-docs"
  mode = "fast"  # Options: "fast" or "hi_res" (for images/tables)
  metadata = {
    type = "documentation"
    framework = "aicl"
    language = "markdown"
  }
  aiclResourceName = "codebase_docs"
}

# Query Ragie for relevant information
resource "ragie_retrieval" "rag_query" {
  query = "What providers are available in the AICL framework?"
  top_k = 5
  rerank = true
  recency_bias = false
  partition = "aicl-docs"
  aiclResourceName = "rag_query"
}

# Use Naga chat to generate answer based on Ragie context
resource "naga_chat" "answer" {
  model = "gpt-4o-2024-08-06"
  messages = [
    {
      role = "system"
      content = "You are a helpful assistant that answers questions about the AICL framework based on the provided context."
    },
    {
      role = "user"
      content = "Question: What providers are available in the AICL framework?\n\nContext from Ragie:\n${resource.ragie_retrieval.rag_query.attributes.chunks}\n\nProvide a detailed answer based on the context."
    }
  ]
  max_tokens = 500
  temperature = 0.7
  aiclResourceName = "answer"
}
