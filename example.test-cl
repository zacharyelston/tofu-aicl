terraform {
  required_providers {
    command_assertion = {
      source  = "aicl/command_assertion"
      version = "~> 1.0"
      container = {
        image = "aicl/command_assertion:1.0.0"
      }
    }
  }
}

variable "code_to_test" {
  type    = string
  default = "print('hello world')"
}

resource "command_assertion" "python_execution" {
  command = "python"
  input   = var.code_to_test

  assert {
    condition     = self.output.exit_code == 0
    error_message = "Generated Python code failed to execute. Stderr: ${self.output.stderr}"
  }
}