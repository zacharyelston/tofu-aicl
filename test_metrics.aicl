terraform {
  required_providers {
    openrouter = {
      source  = "aicl/openrouter"
      version = "~> 1.0"
    }
  }
}

resource "chat" "test" {
  model = "anthropic/claude-3.5-sonnet"
  messages = [
    {
      role = "user"
      content = "Suggest 3 improvements to Python code quality"
    }
  ]
  max_tokens = 300
}
